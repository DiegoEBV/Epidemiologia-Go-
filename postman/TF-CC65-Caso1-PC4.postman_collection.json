        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Latencia < 100 ms (\" + pm.response.responseTime + \" ms)\", () => pm.expect(pm.response.responseTime).to.be.below(100));",
                  "pm.test(\"Cabecera X-Response-Time presente\", () => pm.response.to.have.header(\"X-Response-Time\"));",
                  "const j = pm.response.json();",
                  "pm.test(\"Coordinador listo\", () => pm.expect(j.estado).to.eql(\"listo\"));",
                  "pm.test(\"4 nodos activos\", () => pm.expect(j.nodos_activos).to.eql(4));",
                  "pm.test(\"MongoDB y Redis conectados\", () => { pm.expect(j.mongo).to.be.true; pm.expect(j.redis).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        },
